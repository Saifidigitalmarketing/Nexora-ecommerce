# Supabase project (Settings → API). The anon key is safe for the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for auth redirects and PWA metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER prefix the service-role key with NEXT_PUBLIC_. It is not required by
# this app; all privileged work runs through SECURITY DEFINER database
# functions guarded by auth.uid() and role checks.

# Optional: register the service worker during `npm run dev` (PWA testing)
# NEXT_PUBLIC_SW_DEV=1
